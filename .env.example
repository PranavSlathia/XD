# Copy to `.env` and fill in. `.env` is gitignored.

# --- Postgres (matches compose.yml services) ---
DH_DB_HOST=dh-pg
DH_DB_PORT=5432
DH_DB_NAME=dh
DH_DB_USER=dh
DH_DB_PASSWORD=changeme-local-only

# --- Redis ---
DH_REDIS_URL=redis://dh-redis:6379/0
# Host-side mapping is 6381 (6380 is taken by moc-falkordb on this Dell).
# Workers/api inside the dh-net network use the internal 6379 above.

# --- Logging / runtime ---
# dev | prod
DH_LOG_LEVEL=INFO
DH_ENV=dev
DH_BIND_ADDR=127.0.0.1
# Keep true before enabling private Tailscale Serve.
DH_API_V1_AUTH_REQUIRED=true
DH_API_PUBLIC_BASE_URL=https://prsnl.tail625ab9.ts.net

# --- Discord operator surface (Vulture) ---
DH_DISCORD_WEBHOOK_URL=
DH_DISCORD_BOT_TOKEN=
DH_DISCORD_GUILD_ID=0
DH_DISCORD_CHANNEL_ID=0
DH_DISCORD_OWNER_ID=0
DH_DISCORD_DIGEST_HOUR_UTC=3
DH_DISCORD_DIGEST_MINUTE_UTC=30

# --- Spend caps ---
DH_LLM_DAILY_CALL_CAP=200
DH_WHOISJSON_DAILY_CAP=33
DH_WHOISFREAKS_DAILY_CAP=15
# 10 GB
DH_BIGQUERY_MAX_BYTES_BILLED=10737418240
# Hard monthly paid-enrichment ceiling: $25 in microUSD.
DH_PAID_ENRICHMENT_MONTHLY_CAP_MICROS=25000000

# --- Historical LLM transport (not used by active GitHub discovery) ---
# 'codex_cli' | 'anthropic_api' (future) | 'openai_api' (future) | 'stub'
DH_CLASSIFIER_TRANSPORT=stub
DH_CLASSIFIER_ENFORCE_HARD_FILTERS=false
DH_CODEX_BIN=codex

# --- Retired GitHub/A2 research settings (historical code only; no active worker/CLI) ---
# Path to a service-account JSON, OR leave empty if running on a host with default ADC.
GOOGLE_APPLICATION_CREDENTIALS=
DH_BIGQUERY_PROJECT=
DH_GITHUB_TOKEN=

# --- WhoisJSON (RDAP fallback for non-RDAP TLDs) ---
DH_WHOISJSON_API_KEY=

# OpenPageRank API key. New keys come from
# https://openpagerank.keywordseverywhere.com/ and start with `opr_`.
# Legacy keys/endpoints stop working on 2026-09-30; the client supports both.
DH_OPENPAGERANK_API_KEY=

# --- DataForSEO pilot (read-only backlinks/search evidence) ---
DH_DATAFORSEO_LOGIN=
DH_DATAFORSEO_PASSWORD=

# --- Always-on expiring inventory ---
# DropCatch pending-delete listings + OpenPageRank Top-10-Million intersection.
# Public read-only sources; no buying or bidding code exists in the worker.
DH_INVENTORY_DATA_DIR=/var/data/dh
DH_INVENTORY_INTERVAL_HOURS=6
DH_INVENTORY_TLDS=com,net,org,co,io,ai
DH_INVENTORY_MIN_OPR=2.5
DH_INVENTORY_MIN_REFERRING_DOMAINS=10
DH_INVENTORY_MAX_CANDIDATES=500
DH_INVENTORY_DETAIL_LIMIT=150
DH_NAME_INVENTORY_CANDIDATE_LIMIT=1000
DH_NAME_SCREEN_MIN_SCORE=65
DH_INVENTORY_REFERENCE_REFRESH_DAYS=30
DH_NAMEBIO_RETAIL_STATS_REFRESH_HOURS=24
DH_OPPORTUNITY_RESEARCH_THRESHOLD=45
DH_OPPORTUNITY_MIN_KEYWORD_SALES=10

# --- Typed job/event worker ---
DH_OPERATOR_JOB_INTERVAL_SECONDS=5
DH_OPERATOR_WORKER_NAME=dh-worker-operator
# Stop claiming new jobs before the Dell's 15-minute load reaches 3.0.
DH_OPERATOR_MAX_LOAD_15M=2.8
DH_EVENT_POLL_INTERVAL_SECONDS=2
DH_EVENT_KEEPALIVE_SECONDS=15

# RDAP checks active acquisition inventory twice daily. Unknown responses are
# backed off for a week instead of being retried every worker tick.
DH_RDAP_ACTIVE_STALE_HOURS=12
DH_RDAP_AVAILABLE_STALE_HOURS=24
DH_RDAP_REGISTERED_STALE_DAYS=30
DH_RDAP_UNKNOWN_STALE_DAYS=7

# --- Read-only registrar availability and normal-price quotes ---
# Needed before any candidate can pass the shared Ready gates.
DH_PORKBUN_API_KEY=
DH_PORKBUN_SECRET_API_KEY=
DH_PORKBUN_DAILY_QUOTE_CAP=50

# --- Legacy composite-score and digest display settings ---
DH_PREMIUM_CEILING_USD=200
DH_DIGEST_MIN_SCORE=40
DH_DIGEST_MAX_ITEMS=10
DH_OPR_MIN_AUTHORITY=3.0

# --- Observability ---
DH_SENTRY_DSN=
DH_OTEL_EXPORTER_OTLP_ENDPOINT=
DH_OTEL_CONSOLE_EXPORTER=false
DH_OTEL_SAMPLE_RATE=0.05
